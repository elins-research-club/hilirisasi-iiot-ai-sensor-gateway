# Copy to .env and adjust on Raspberry Pi.
IIOT_CONFIG_FILE=config/default.toml
IIOT_GATEWAY_ID=raspi_gateway_01
IIOT_LOG_LEVEL=INFO

# Input mode is file for the current pre-model pipeline.
# Future hardware integration can map this to serial or LoRa receiver output.
IIOT_INPUT_FILE=data/simulated/payloads.jsonl
IIOT_OUTPUT_DIR=data/processed
