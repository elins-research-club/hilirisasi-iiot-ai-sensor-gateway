[Unit]
Description=IIoT AI Sensor Gateway ChirpStack live runtime
Wants=iiot-node-usb-release.service
After=default.target iiot-node-usb-release.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/apps/iiot-ai-sensor-gateway/current
EnvironmentFile=-%h/.config/iiot-ai-sensor-gateway/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/apps/iiot-ai-sensor-gateway/current/.venv/bin/python run_gateway.py run-live-chirpstack --config config/iiotgw.toml
Restart=always
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/iiot-ai-sensor-gateway

[Install]
WantedBy=default.target
